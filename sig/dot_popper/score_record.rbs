module DotPopper
  class ScoreRecord
    interface _SaveFile
      def read: () -> String?

      def write: (String text) -> void
    end

    interface _Removable
      include _SaveFile

      def remove: () -> void
    end

    @file: _SaveFile

    @legacy: Gameplay::SizeClass

    @values: Hash[Gameplay::SizeClass, Integer]

    def initialize: (_SaveFile file, ?legacy: Gameplay::SizeClass) -> void

    def of: (Gameplay::SizeClass size_class) -> Integer

    def first?: (Gameplay::SizeClass size_class) -> bool

    def record: (Integer score, Gameplay::SizeClass size_class) -> bool

    def saved: () -> String?

    def clear: () -> void

    def restore: (String? text) -> void

    private

    def save: () -> void

    module Table
      OLD: Regexp

      def self.parse: (String text, legacy: Gameplay::SizeClass) -> Hash[Gameplay::SizeClass, Integer]

      def self.old?: (String text) -> bool

      def self.to_text: (Hash[Gameplay::SizeClass, Integer] values) -> String
    end

    class Memory
      @text: String?

      def initialize: (?String? text) -> void

      def read: () -> String?

      def write: (String text) -> String

      def remove: () -> nil
    end
  end
end
