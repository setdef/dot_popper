module DotPopper
  module Monetization
    module Receipt
      # The code that checks one store's receipts (Apple, Play, Microsoft).
      interface _Store
        def name_in_receipts: () -> String
        def valid?: (String text, Trust trust) -> bool
      end

      class Trust
        attr_reader store: _Store?
        attr_reader keys: Array[String]
        attr_reader app_id: String
        attr_reader product_id: String

        def initialize: (store: _Store?, keys: Array[String], app_id: String, product_id: String) -> void

        def with: (?store: _Store?, ?keys: Array[String], ?app_id: String, ?product_id: String) -> Trust
      end

      APP_ID: String
      PRODUCT_ID: String
      APPLE_ROOT_G3: String
      PLAY_KEYS: Array[String]
      NOTHING: Array[String]
      NONE: Trust
      APPLE: Trust
      PLAY: Trust
      MICROSOFT_STORE: Trust
      TEST: Trust

      module TestKey
        PRIVATE: String
        PUBLIC: String
      end

      def self.valid?: (untyped text, Trust trust) -> bool
      def self.load_openssl: () -> void
      def self.issue: (?key: String, ?app_id: String, ?product_id: String, ?state: Integer, ?at: Time) -> String

      module Apple
        LEAF: String
        INTERMEDIATE: String

        def self?.name_in_receipts: () -> String

        def self?.valid?: (String jws, Trust trust) -> bool

        def self?.chained?: (untyped leaf, untyped intermediate, Trust trust, Time at) -> boolish

        def self?.marked?: (untyped certificate, String oid) -> bool

        def self?.decode: (String? text) -> String

        def self?.der: (String raw) -> String
      end

      module Play
        def self?.name_in_receipts: () -> String

        def self?.valid?: (String text, Trust trust) -> bool
      end

      module Microsoft
        SKU: Regexp

        def self?.name_in_receipts: () -> String

        def self?.valid?: (String text, Trust trust) -> bool
      end
    end
  end
end
