module DotPopper
  module Monetization
    module Receipt
      class Trust
        attr_reader apple_roots: Array[String]
        attr_reader play_keys: Array[String]
        attr_reader app_id: String
        attr_reader product_id: String
        attr_reader windows_license: bool

        def initialize: (apple_roots: Array[String], play_keys: Array[String], app_id: String, product_id: String, windows_license: bool) -> void

        def with: (?apple_roots: Array[String], ?play_keys: Array[String], ?app_id: String, ?product_id: String, ?windows_license: bool) -> Trust
      end

      APP_ID: String
      PRODUCT_ID: String
      APPLE_ROOT_G3: String
      PLAY_KEYS: Array[String]
      NOTHING: Array[String]
      NONE: Trust
      APPLE: Trust
      PLAY: Trust
      MICROSOFT_STORE: Trust
      TEST: Trust

      module TestKey
        PRIVATE: String
        PUBLIC: String
      end

      def self.valid?: (untyped text, Trust trust) -> bool
      def self.load_openssl: () -> void
      def self.issue: (?key: String, ?app_id: String, ?product_id: String, ?state: Integer, ?at: Time) -> String

      module Apple
        LEAF: String
        INTERMEDIATE: String

        def self?.valid?: (String jws, Trust trust) -> bool

        def self?.chained?: (untyped leaf, untyped intermediate, Trust trust, Time at) -> boolish

        def self?.marked?: (untyped certificate, String oid) -> bool

        def self?.decode: (String? text) -> String

        def self?.der: (String raw) -> String
      end

      module Play
        def self?.valid?: (String text, Trust trust) -> bool
      end

      module Microsoft
        SKU: Regexp

        def self?.valid?: (String text, Trust trust) -> bool
      end
    end
  end
end
