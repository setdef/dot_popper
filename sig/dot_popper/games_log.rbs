module DotPopper
  class GamesLog
    COLUMNS: Array[String]

    HEADER: String

    @archive: ^(String name) -> ScoreRecord::_SaveFile

    @file: ScoreRecord::_SaveFile

    @now: ^() -> Time

    @today: ^() -> Date

    @recorder: GameStats::Recorder

    def initialize: (ScoreRecord::_SaveFile file, ?now: ^() -> Time, ?today: ^() -> Date,
                     ?archive: ^(String name) -> ScoreRecord::_SaveFile) -> void

    def call: (Gameplay::event event) -> void

    private

    def row: (Gameplay::Events::GameEnded ended, GameStats stats) -> String

    def seconds: (Float value) -> String

    def append: (String line) -> void

    def current: () -> String

    def set_aside: (String old) -> void
  end
end
