module DotPopper
  class AchievementRecorder
    @watching: bool

    @targets: Hash[Float, Gameplay::TouchTarget]

    @found: Array[Achievement::id]

    @sharp: Integer

    @dots_in_a_row: Integer

    @mistaken: bool

    @low: bool

    @early: Integer

    @last_pop: Float?

    @covered: bool

    @tapped: bool

    def initialize: () -> void

    def earned: () -> Array[Achievement::id]

    def call: (Gameplay::event event) -> void

    private

    def reset: () -> void

    def begin_game: (Gameplay::Events::GameStarted started) -> void

    def popped: (Gameplay::Events::Popped event) -> void

    def mistake_made: (Gameplay::Events::MistakeMade event) -> void

    def ended: (Gameplay::Events::GameEnded event) -> void

    def sharp: (Gameplay::Dot dot, Array[Gameplay::Dot] above) -> void

    def time_to_pop: (Float seconds) -> void

    def dots_in_a_row: () -> void

    def early: (Gameplay::Events::Popped popped) -> void

    def note_low_clock: (Gameplay::Events::Popped | Gameplay::Events::MistakeMade tapped) -> void

    def appeared: (Gameplay::Dot dot, Array[Gameplay::Dot] above, Gameplay::Events::Popped popped) -> void

    def target: (Float radius) -> Gameplay::TouchTarget

    def find: (Achievement::id id) -> void
  end
end
