module DotPopper
  module ReleaseEngineering
    module Build
      CHANNEL: String?
      PARTS: Array[String]
      APP_STORE: String
      MAC_APP_STORE: String
      GOOGLE_PLAY: String
      MICROSOFT_STORE: String
      WEBSITE: String
      PREFIX: String
      HARMLESS: Array[String]

      def self.store?: (?String? channel) -> bool
      class Channel < ::Data
        attr_reader name: String

        attr_reader store: bool

        attr_reader parts: Array[String]

        def self.new: (name: String, store: bool, parts: Array[String]) -> instance
      end

      NO_PARTS: Array[String]
      CHANNELS: Hash[String, Channel]
      STORES: Array[String]
      CHANNEL_NAMES: Array[String]
      def self.settings: (?untyped env, ?channel: String?) -> untyped
    end
  end
end
