module DotPopper
  module UseCases
    class StartGame
      type result = :started | :offer | :not_home

      @game_flow: Gameplay::GameFlow
      @starter: Gameplay::GameFlow::Starter
      @free_games: FreeGames

      def initialize: (game_flow: Gameplay::GameFlow, free_games: FreeGames, ?starter: Gameplay::GameFlow::Starter) -> void

      def none_left?: () -> bool

      def left: () -> Integer?

      def daily: () -> Integer

      def call: (?Gameplay::Stack? opening) -> result
    end

    # A player's friend groups, as Groups::Session tells them of games
    # and achievements.
    interface _FriendGroups
      def game_finished: (score: Integer, counts: bool) -> void

      def report_achievements: (Array[Achievement::id] ids) -> void
    end

    class FinishGame
      @saved_stats: SavedStats
      @achievements: Achievements
      @entitlement: Entitlement
      @friend_groups: _FriendGroups
      @recorder: GameStats::Recorder
      @achievement_recorder: AchievementRecorder
      @listeners: Array[_FinishedListener]

      interface _FinishedListener
        def call: (Finished finished) -> void
      end

      def initialize: (saved_stats: SavedStats, achievements: Achievements, entitlement: Entitlement, friend_groups: _FriendGroups) -> void

      def subscribe: (_FinishedListener listener) -> self

      def stats: () -> GameStats

      def call: (Gameplay::event event) -> void

      class Result < ::Data
        attr_reader record: Stats::Record?

        attr_reader goal_met: bool

        attr_reader achievements: Array[Achievement::id]

        def self.new: (record: Stats::Record?, goal_met: bool, achievements: Array[Achievement::id]) -> instance
      end

      class Finished < ::Data
        attr_reader ended: Gameplay::Events::GameEnded

        attr_reader stats: GameStats

        attr_reader result: Result

        def self.new: (ended: Gameplay::Events::GameEnded, stats: GameStats, result: Result) -> instance
      end

      private

      def finish: (Gameplay::Events::GameEnded ended, stats: GameStats, ?earned: Array[Achievement::id]) -> Result
    end

    class BuyPro
      @store: DotPopper::_Store
      @entitlement: Entitlement
      @game_flow: Gameplay::GameFlow
      @achievements: Achievements
      @friend_groups: _FriendGroups

      def initialize: (store: DotPopper::_Store, entitlement: Entitlement, game_flow: Gameplay::GameFlow, achievements: Achievements, friend_groups: _FriendGroups) -> void

      def offered?: () -> bool

      def sold?: () -> bool

      def keys?: () -> bool

      def price: () -> String?

      def status: () -> Symbol

      def typed: () -> String

      def open: () -> void

      def buy: () -> bool

      def restore: () -> void

      def paste: () -> void

      def type: (untyped key) -> bool

      def update: (Float seconds) -> void

      def call: (Entitlement::ProGranted granted) -> void

      private

      def owned?: () -> bool
    end

    class UseTheme
      @saved_themes: SavedThemes
      @entitlement: Entitlement

      attr_reader current: theme_key

      def initialize: (saved_themes: SavedThemes, entitlement: Entitlement) -> void

      def choice: (theme_key? key) -> (:use | :same | :offer)

      def call: (theme_key key) -> (:offer | :same | :used)

      def refresh: () -> theme_key

      private

      def locked?: () -> bool

      def same?: (theme_key key) -> bool
    end

    # What a friend group's Join and Create ask of Groups::Session.
    interface _Groups
      def create: () -> void

      def join: (String code) -> void
    end

    class JoinOrCreateFriendGroup
      @groups: _Groups
      @entitlement: Entitlement

      def initialize: (groups: _Groups, entitlement: Entitlement) -> void

      def start: () -> (:offer | :go)

      def create: () -> (:sent | :offer)

      def join: (String code) -> (:sent | :offer)

      private

      def locked?: () -> bool
    end

    class ViewAchievements
      @achievements: Achievements
      @entitlement: Entitlement
      @saved_stats: SavedStats
      @score_record: ScoreRecord

      def initialize: (achievements: Achievements, entitlement: Entitlement, saved_stats: SavedStats, score_record: ScoreRecord) -> void

      def status: (Achievement::id id) -> (:earned | :not_earned | :offer)

      def earned?: (Achievement::id id) -> bool

      def day: (Achievement::id id) -> String?

      def count: () -> Integer?

      def progress: (Achievement::id id) -> [Integer, Integer]?

      private

      def locked?: () -> bool

      def most_dots_in_a_row: (Array[Stats::RecordSet] records) -> Integer
    end
  end
end
