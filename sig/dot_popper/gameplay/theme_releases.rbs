module DotPopper
  module Gameplay
    class ThemeReleases
      REQUESTS: Hash[Symbol, Network::Request]

      @worker: Network::_Worker

      @saved_themes: SavedThemes

      @file: ScoreRecord::_SaveFile

      @now: ^() -> Time

      def self.keys: (untyped body) -> Array[String]?

      def initialize: (worker: Network::_Worker, saved_themes: SavedThemes, file: ScoreRecord::_SaveFile, ?now: ^() -> Time) -> void

      def started_on: () -> String

      def ask: () -> void

      def update: () -> bool

      private

      def receive: (Network::Reply reply) -> bool
    end
  end
end
