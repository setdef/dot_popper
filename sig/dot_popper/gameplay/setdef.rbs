module DotPopper
  module Gameplay
    # A check left setdef gone, as Gameplay hears it (setdef.rb).
    class SetdefGone < ::Data
      attr_reader since: Date

      attr_reader today: Date

      def self.new: (since: Date, today: Date) -> instance

      def days: () -> Integer
    end

    # setdef's server answered, as Gameplay hears it.
    class SetdefHere < ::Data
      def self.new: () -> instance
    end

    type setdef_event = SetdefGone | SetdefHere
  end
end
