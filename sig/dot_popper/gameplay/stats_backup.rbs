module DotPopper
  module Gameplay
    class StatsBackup
      interface _Kept
        def saved: () -> String?

        def clear: () -> void

        def restore: (String? text) -> void
      end

      type folder = ^(String name) -> ::DotPopper::_RemovableSaveFile

      NOTE: String

      BACKUP: Regexp

      @kept: Hash[String, _Kept]

      @folder: folder | Folder

      @now: ^() -> Time

      @cleared: bool

      def initialize: (score_record: _Kept, saved_stats: _Kept, ?achievements: _Kept?, ?folder: folder | Folder, ?now: ^() -> Time) -> void

      def cleared?: () -> bool

      def clear: () -> Cleared

      def restore: (Cleared cleared) -> void

      class Cleared < ::Data
        attr_reader texts: Hash[String, String?]

        def self.new: (texts: Hash[String, String?]) -> instance
      end

      class Folder
        @files: Hash[String, ::DotPopper::MemoryFile]

        def initialize: () -> void

        def call: (String name) -> ::DotPopper::MemoryFile
      end

      private

      def finish_stopped_clear: () -> void

      def backups: () -> Hash[String, String]

      def back_up: (Hash[String, String?] texts) -> void
    end
  end
end
