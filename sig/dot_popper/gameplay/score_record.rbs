module DotPopper
  module Gameplay
    class ScoreRecord
      @file: ::DotPopper::_SaveFile

      @legacy: SizeClass

      @values: Hash[SizeClass, Integer]

      def initialize: (::DotPopper::_SaveFile file, ?legacy: SizeClass) -> void

      def of: (SizeClass size_class) -> Integer

      def first?: (SizeClass size_class) -> bool

      def record: (Integer score, SizeClass size_class) -> bool

      def saved: () -> String?

      def clear: () -> void

      def restore: (String? text) -> void

      private

      def save: () -> void
    end

    # What score_record.txt holds (score_record_file.rb).
    class ScoreRecordFile < ::Data
      OLD: Regexp

      attr_reader scores: Hash[SizeClass, Integer]

      def self.new: (scores: Hash[SizeClass, Integer]) -> instance

      def self.parse: (String? text, legacy: SizeClass) -> ScoreRecordFile

      def self.old?: (String text) -> bool

      def to_s: () -> String
    end
  end
end
