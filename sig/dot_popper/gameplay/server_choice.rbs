module DotPopper
  module Gameplay
    class ServerChoice
      # What the address is pasted from (Presentation::Clipboard and the
      # shell's).
      interface _Clipboard
        def paste: () -> String?
      end

      @file: ScoreRecord::_SaveFile

      @gone: bool

      @clipboard: _Clipboard

      @status: (:chosen | :not_https | :empty)?

      attr_reader status: (:chosen | :not_https | :empty)?

      def initialize: (ScoreRecord::_SaveFile file, gone: bool, clipboard: _Clipboard) -> void

      def offered?: () -> bool

      def address: () -> String?

      def server_url: (String own) -> String

      def paste: () -> (:chosen | :not_https | :empty)

      def reset: () -> void

      def forget: () -> void

      def call: (setdef_event event) -> void

      def self.https?: (String text) -> bool
    end
  end
end
