module DotPopper
  module Gameplay
    # What stats.txt holds (stats_file.rb).
    class StatsFile < ::Data
      DAY: Regexp

      UNKNOWN: String

      attr_reader stats: Stats

      def self.new: (stats: Stats) -> instance

      def self.parse: (String? text, ?legacy: SizeClass) -> StatsFile

      def self.old?: (String? text) -> bool

      def self.record_set: (Pairs pairs) -> Stats::RecordSet

      def to_s: () -> String

      class Pairs < ::Data
        attr_reader values: Hash[String, String]

        def self.new: (values: Hash[String, String]) -> instance

        def self.parse: (String? text) -> Pairs

        def count: (Symbol key) -> Integer

        def time: (Symbol key) -> Float?

        def counts: (Symbol key) -> Array[Integer]

        def classes: (Symbol key) -> Array[SizeClass?]

        def day: (Symbol key) -> String?

        def within: (String prefix) -> Pairs

        private

        def natural: (String? text) -> Integer?
      end

      private

      def pairs_of: (Stats::RecordSet set) -> Array[[String, number?]]
    end
  end
end
