module DotPopper
  module Monetization
    class FreeGames
      FIRST_GAMES: Integer
      DAILY: Integer

      @file: ::DotPopper::_SaveFile
      @today: ^() -> Date
      @entitlement: Entitlement
      @metered: bool
      @daily: Integer
      @day: Date?
      @spent: Integer
      @first_games: Integer
      @used: Integer

      attr_reader daily: Integer

      STARTING: String

      def self.metered?: (offered: bool, player: bool) -> bool
      def self.unlimited: () -> FreeGames
      def initialize: (::DotPopper::_SaveFile file, today: ^() -> Date, entitlement: Entitlement, ?metered: bool, ?first_games: Integer, ?daily: Integer) -> void
      def metered?: () -> bool
      def daily_left: () -> Integer
      def first_games_left: () -> Integer
      def left: () -> Integer
      def can_play?: () -> bool
      def spend!: () -> bool

      private

      def today: () -> Date
      def day: (String? text) -> Date?
      def count: (String? text, Integer default) -> Integer
    end
  end
end
