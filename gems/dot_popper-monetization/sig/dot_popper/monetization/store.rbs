module DotPopper
  module Monetization
    # Any store, as the offer of Pro reaches it through UseCases::BuyPro:
    # Store, WebsiteStore, NoStore, or a channel's own.
    interface _Store
      def offered?: () -> bool

      def sold?: () -> bool

      def price: () -> String?

      def status: () -> Symbol

      def connect: () -> void

      def buy: () -> void

      def restore: () -> void

      def update: (Float seconds) -> void
    end

    class Store
      # The port to a store's host: a URL asks, and an answer file answers.
      interface _Port
        def open: (String url) -> bool

        def read: () -> String?

        def remove: () -> void

        def path: () -> String
      end

      SCHEME: String
      PRODUCT_ID: String
      EVERY: Float
      UNRESERVED: Regexp
      STATES: Hash[String, Symbol]

      @port: _Port
      @entitlement: Entitlement
      @status: Symbol
      @price: String?
      @number: Integer
      @since: Float

      attr_reader status: Symbol

      attr_reader price: String?

      def self.for: (Platform platform, native: _Port, entitlement: Entitlement,
                     channel: String?, ?website: (^() -> _Store)?) -> _Store

      def self.url: (Symbol | String action, Integer number, String path) -> String

      def self.encode: (Object value) -> String

      def initialize: (port: _Port, entitlement: Entitlement) -> void

      def offered?: () -> bool

      def sold?: () -> bool

      def connect: () -> void

      def buy: () -> void

      def restore: () -> void

      def update: (Float seconds) -> void

      private

      def request: (Symbol action, Symbol status) -> void

      def heard: (String? text) -> void
    end

    class NativeStore < ::Data
      # The system's URL opener.
      interface _Opener
        def open: (String url) -> bool
      end

      # The file the host writes the store's answers to.
      interface _Answers
        def read: () -> String?

        def remove: () -> void

        def path: () -> String
      end

      attr_reader opener: _Opener

      attr_reader answers: _Answers

      def self.new: (opener: _Opener, answers: _Answers) -> instance

      def open: (String url) -> bool

      def read: () -> String?

      def remove: () -> void

      def path: () -> String
    end

    class NoStore
      def offered?: () -> bool

      def sold?: () -> bool

      def status: () -> Symbol

      def price: () -> nil

      def connect: () -> nil

      def buy: () -> nil

      def restore: () -> nil

      def update: (Float _seconds) -> nil
    end
  end
end
