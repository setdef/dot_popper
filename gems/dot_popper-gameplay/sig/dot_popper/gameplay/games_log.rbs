module DotPopper
  module Gameplay
    class GamesLog
      COLUMNS: Array[String]

      HEADER: String

      @archive: ^(String name) -> ::DotPopper::_SaveFile

      @file: ::DotPopper::_SaveFile

      @now: ^() -> Time

      @today: ^() -> Date

      @recorder: GameStats::Recorder

      def initialize: (::DotPopper::_SaveFile file, ?now: ^() -> Time, ?today: ^() -> Date,
                       ?archive: ^(String name) -> ::DotPopper::_SaveFile) -> void

      def call: (event event) -> void

      private

      def row: (Events::GameEnded ended, GameStats stats) -> String

      def seconds: (Float value) -> String

      def append: (String line) -> void

      def current: () -> String

      def set_aside: (String old) -> void
    end
  end
end
