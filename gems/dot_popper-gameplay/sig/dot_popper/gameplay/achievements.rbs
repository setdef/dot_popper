module DotPopper
  module Gameplay
    class Achievements
      @file: ::DotPopper::_SaveFile

      @days: Hash[Achievement::id, String]

      def initialize: (::DotPopper::_SaveFile file) -> void

      def earned?: (Achievement::id id) -> bool

      def earned: () -> Array[Achievement::id]

      def count: () -> Integer

      def day: (Achievement::id id) -> String?

      def award: (Array[Achievement::id] ids, day: String) -> Array[Achievement::id]

      def saved: () -> String?

      def clear: () -> void

      def restore: (String? text) -> void
    end

    # What achievements.txt holds (achievements_file.rb).
    class AchievementsFile < ::Data
      attr_reader days: Hash[Achievement::id, String]

      def self.new: (days: Hash[Achievement::id, String]) -> instance

      def self.parse: (String? text) -> AchievementsFile

      def to_s: () -> String
    end
  end
end
