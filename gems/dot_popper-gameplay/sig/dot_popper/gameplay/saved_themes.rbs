module DotPopper
  module Gameplay
    class SavedThemes
      GONE_DAYS: Integer

      @file: ::DotPopper::_SaveFile

      @themes: Array[Theme]

      @released: Array[theme_key]

      @told: Array[theme_key]

      @chosen: theme_key?

      def initialize: (::DotPopper::_SaveFile file, ?themes: Array[Theme]) -> void

      def ordinary: () -> theme_key

      def chosen: () -> theme_key

      def choices: () -> Array[theme_key]

      def open?: (theme_key key) -> bool

      def offered?: () -> bool

      def release: (Array[String | Symbol] keys) -> bool

      def call: (setdef_event event) -> void

      def open_by_date: (Date today, Integer gone_days) -> bool

      def new_theme: () -> theme_key?

      def told: (theme_key key) -> void

      def use: (theme_key key) -> void

      private

      def known?: (theme_key key) -> bool

      def read: () -> [Array[theme_key], Array[theme_key], theme_key?]

      def save: () -> void
    end

    # What themes.txt holds (themes_file.rb).
    class ThemesFile < ::Data
      RELEASED: String

      TOLD: String

      CHOSEN: String

      attr_reader released: Array[theme_key]

      attr_reader told: Array[theme_key]

      attr_reader chosen: theme_key?

      def self.new: (released: Array[theme_key], told: Array[theme_key], chosen: theme_key?) -> instance

      def self.parse: (String? text) -> ThemesFile

      def self.keys: (String line) -> Array[theme_key]

      def to_s: () -> String
    end
  end
end
